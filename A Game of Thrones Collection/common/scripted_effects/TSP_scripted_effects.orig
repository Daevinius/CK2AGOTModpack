dynamite_devils_reef = { # If one religion goes full Lovecraft, all of the other Lovecraft religions also upgrade
	if = {
		limit = {
			NOT = {
				religion = black_goat
				religion = black_goat_reformed
			}
		}
		remove_evil_god_names = yes
	}
	if = {
		limit = {
			NOT = {
				religion = black_goat
				religion = black_goat_reformed
				religion = trios
				religion = trios_reformed
				religion = father_of_waters
				religion = father_of_waters_reformed
			}
		}
		set_high_god_name = GOD_OLD_ONES
	}

	add_god_name = GOD_Nyarlathotep
	add_god_name = GOD_Azathoth
	add_god_name = GOD_Yog-Sothoth
	add_god_name = GOD_CTHULHU
	add_god_name = GOD_OLD_ONES
	add_evil_god_name = GOD_THE_OTHERS

	set_looting = yes
	set_can_toggle_looting = yes
	allow_looting = yes
	seafarer = yes

	if = {
		limit = {
			ROOT = {
				OR = {
					religion = black_goat
					religion = black_goat_reformed
				}
			}
		}
		black_goat = {
			add_intermarry = old_ones
			add_intermarry = fish_gods
			add_intermarry = sothoryos_rel
			add_intermarry = starry_wisdom
		}
